# Puerto local del servidor
PORT=3000

# Token de acceso de la app de Meta (temporal de prueba o permanente de un System User)
WHATSAPP_TOKEN=

# Phone Number ID del numero de WhatsApp Business (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (opcional, util para algunos endpoints)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Token que tu defines para verificar el webhook (cualquier cadena secreta)
WHATSAPP_VERIFY_TOKEN=

# App Secret de la app de Meta, para validar la firma de los webhooks (recomendado en produccion)
WHATSAPP_APP_SECRET=

# Version de la Graph API a usar
GRAPH_API_VERSION=v20.0
